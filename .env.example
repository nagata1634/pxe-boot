# cp .env.example .env して値を入れる（.env は gitignore）
NAS_HOST=192.168.11.2      # PXE サーバー(NAS)の LAN 上の IP
LAN_SUBNET=192.168.11.0    # proxyDHCP が応答するサブネット(ルータの DHCP と同じ)
PXE_IFACE=eth0             # dnsmasq を待ち受けさせる NAS の NIC(空なら全 IF)
NAS_SSH=qnap-yuuya         # setup-iso.sh が rsync する先(ssh config の別名)
NAS_DIR=/share/CACHEDEV1_DATA/Container/pxe-boot
